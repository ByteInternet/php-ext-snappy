Source: php-ext-snappy
Section: php
Priority: optional
Maintainer: Hypernode Tech Team <tech.team@hypernode.com>
Build-Depends: debhelper (>= 10),
               dh-php (>= 4~),
               php-all-dev,
               libsnappy-dev
Standards-Version: 4.5.1
Vcs-Git: https://github.com/ByteInternet/php-ext-snappy

Package: php-ext-snappy
Architecture: any
Pre-Depends: php-common (>= 2:69~)
Depends: libsnappy1v5
         ${misc:Depends},
         ${pecl:Depends},
         ${php:Depends},
         ${shlibs:Depends}
Breaks: ${pecl:Breaks}
Replaces: ${pecl:Replaces}
Provides: ${pecl:Provides}
          ${php:Provides}
Suggests: ${pecl:Suggests}
Description: Snappy Extension for PHP
